{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["me.adoloveschicken.entombed.EntombedFabric"],
    "client": ["me.adoloveschicken.entombed.EntombedFabricClient"],
    "jade": ["me.adoloveschicken.entombed.integration.jade.TombPlugin"]
  },
  "mixins": ["entombed.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}"
  },
  "suggests": {
    "jade": "*",
    "trinkets": "*",
    "accessories": "*",
    "inventorio": "*"
  }
}